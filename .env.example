# Local HTTP service
APP_HOST=127.0.0.1
APP_PORT=8080
CYCLONE_DATA_PATH=data/normalized
ENRICHMENT_DATA_PATH=data/enriched
RISK_DATA_PATH=data/risk
FORECAST_DATA_PATH=data/forecast
ADVISORY_DATA_PATH=data/advisories

# Browser-restricted Google Maps JavaScript API key. Leave blank for the local coordinate-map fallback.
GOOGLE_MAPS_API_KEY=

# GCP deployment identifiers. These are identifiers, never credentials.
GCP_PROJECT_ID=
GCP_REGION=asia-south1
GCP_STORAGE_BUCKET=
BIGQUERY_DATASET=cyclone_intelligence

# Optional identifier for a future authenticated Earth Engine import. The local fixture does not use it.
EARTH_ENGINE_PROJECT=

# Phase 5 grounded assistant. Local is deterministic and requires no cloud credentials.
GEMINI_PROVIDER=local
VERTEX_AI_MODEL=gemini-2.5-flash
# Required only for GEMINI_PROVIDER=vertex. Set this securely in the runtime; never commit it.
VERTEX_AI_ACCESS_TOKEN=
